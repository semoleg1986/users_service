# users_service deploy profile
USERS_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/users_service
USERS_USE_INMEMORY=0
USERS_AUTO_CREATE_SCHEMA=0
USERS_AUTH_ISSUER=auth_service
USERS_AUTH_AUDIENCE=platform_clients
USERS_AUTH_JWKS_URL=http://auth_service:8000/.well-known/jwks.json

USERS_SERVICE_TOKEN=dev-service-token
