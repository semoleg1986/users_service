# users_service env profiles
#
# Как использовать:
# 1) Скопируйте нужный профиль в .env
# 2) Запустите сервис
#
# Пример:
#   cp .env.local.example .env
#   затем оставьте только один профиль (или нужные переменные)

############################################################
# PROFILE: dev-inmemory
############################################################
# USERS_USE_INMEMORY=1
# USERS_DATABASE_URL=sqlite:///./users_service.db
# USERS_AUTO_CREATE_SCHEMA=0
# USERS_AUTH_ISSUER=auth_service
# USERS_AUTH_JWKS_URL=http://localhost:8000/.well-known/jwks.json

############################################################
# PROFILE: dev-postgres
############################################################
# USERS_USE_INMEMORY=0
# USERS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/users_service
# USERS_AUTO_CREATE_SCHEMA=0
# USERS_AUTH_ISSUER=auth_service
# USERS_AUTH_JWKS_URL=http://localhost:8000/.well-known/jwks.json

############################################################
# PROFILE: test-postgres
############################################################
# USERS_USE_INMEMORY=0
# USERS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/users_service_test
# USERS_AUTO_CREATE_SCHEMA=0
# USERS_AUTH_ISSUER=auth_service
#
# Для тестов можно не дергать внешний auth_service и подложить JWKS напрямую:
# USERS_AUTH_JWKS_JSON={"keys":[{"kty":"OKP","crv":"Ed25519","x":"<base64url>","alg":"EdDSA","use":"sig","kid":"test-kid"}]}
